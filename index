  <!-- ============================= -->
  <!-- JAVASCRIPT                  -->
  <!-- ============================= -->
  <script>
  (function () {
    "use strict";

    /* ============================= */
    /* CONFIGURATION                 */
    /* ============================= */
    const CONFIG = {
      storageKey: "5LE_MANAGER_DATA",
      version: 1,
      toastDuration: 3200,
      demoNicknames: ["FuryX571", "Aiko5LE", "Marmotte", "Twazou", "Danycef"],
      roleOrder: { R5: 0, R4: 1, Membre: 2 }
    };

    /* ============================= */
    /* STATE                         */
    /* ============================= */
    let state = createEmptyData();
    let selectedIds = new Set();
    let editingId = null;
    let confirmCallback = null;

    function createEmptyData() {
      return {
        version: CONFIG.version,
        players: [],
        settings: {},
        train: {},
        teams: [],
        templates: [],
        history: []
      };
    }

    function createDemoPlayers() {
      const now = Date.now();
      return [
        { id: uid("player"), nickname: "FuryX571", role: "R4", status: "active", team: "", power: "", note: "", createdAt: new Date(now - 4000).toISOString(), isDemo: true },
        { id: uid("player"), nickname: "Aiko5LE", role: "R5", status: "active", team: "", power: "", note: "", createdAt: new Date(now - 3000).toISOString(), isDemo: true },
        { id: uid("player"), nickname: "Marmotte", role: "Membre", status: "active", team: "", power: "", note: "", createdAt: new Date(now - 2000).toISOString(), isDemo: true },
        { id: uid("player"), nickname: "Twazou", role: "Membre", status: "active", team: "", power: "", note: "", createdAt: new Date(now - 1000).toISOString(), isDemo: true },
        { id: uid("player"), nickname: "Danycef", role: "Membre", status: "active", team: "", power: "", note: "", createdAt: new Date(now).toISOString(), isDemo: true }
      ];
    }

    function uid(prefix) {
      return prefix + "_" + Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);
    }

    /* ============================= */
    /* STOCKAGE                      */
    /* ============================= */
    const Storage = {
      load() {
        try {
          const raw = localStorage.getItem(CONFIG.storageKey);
          if (!raw) return null;
          const data = JSON.parse(raw);
          if (!data || typeof data !== "object") return null;
          return this.normalize(data);
        } catch (e) {
          console.warn("5LE Manager: lecture localStorage échouée", e);
          return null;
        }
      },

      save(data) {
        try {
          localStorage.setItem(CONFIG.storageKey, JSON.stringify(data));
          return true;
        } catch (e) {
          console.error("5LE Manager: sauvegarde échouée", e);
          Notifications.show("Erreur de sauvegarde", "error");
          return false;
        }
      },

      normalize(data) {
        const base = createEmptyData();
        return {
          version: data.version || CONFIG.version,
          players: Array.isArray(data.players) ? data.players.map(normalizePlayer).filter(Boolean) : [],
          settings: data.settings && typeof data.settings === "object" ? data.settings : base.settings,
          train: data.train && typeof data.train === "object" ? data.train : base.train,
          teams: Array.isArray(data.teams) ? data.teams : base.teams,
          templates: Array.isArray(data.templates) ? data.templates : base.templates,
          history: Array.isArray(data.history) ? data.history : base.history
        };
      },

      persist() {
        return this.save(state);
      }
    };

    function normalizePlayer(p) {
      if (!p || typeof p !== "object") return null;
      const nickname = String(p.nickname || "").trim();
      if (!nickname) return null;
      const role = ["R5", "R4", "Membre"].includes(p.role) ? p.role : "Membre";
      const status = p.status === "inactive" ? "inactive" : "active";
      return {
        id: p.id || uid("player"),
        nickname,
        role,
        status,
        team: String(p.team || "").trim(),
        power: String(p.power != null ? p.power : "").trim(),
        note: String(p.note || "").trim(),
        createdAt: p.createdAt || new Date().toISOString(),
        isDemo: !!p.isDemo
      };
    }

    /* ============================= */
    /* NOTIFICATIONS                 */
    /* ============================= */
    const Notifications = {
      show(message, type) {
        const container = document.getElementById("toastContainer");
        const el = document.createElement("div");
        el.className = "toast " + (type || "info");
        el.textContent = message;
        container.appendChild(el);
        setTimeout(function () {
          el.style.opacity = "0";
          el.style.transition = "opacity 0.3s";
          setTimeout(function () { el.remove(); }, 300);
        }, CONFIG.toastDuration);
      }
    };

    /* ============================= */
    /* STATISTIQUES                  */
    /* ============================= */
    const Stats = {
      compute() {
        const players = state.players;
        return {
          total: players.length,
          active: players.filter(function (p) { return p.status === "active"; }).length,
          inactive: players.filter(function (p) { return p.status === "inactive"; }).length,
          r5: players.filter(function (p) { return p.role === "R5"; }).length,
          r4: players.filter(function (p) { return p.role === "R4"; }).length,
          members: players.filter(function (p) { return p.role === "Membre"; }).length
        };
      },

      render() {
        const s = this.compute();
        const grid = document.getElementById("dashboardStats");
        const cards = [
          { value: s.total, label: "Joueurs", icon: "◉", cls: "gold" },
          { value: s.active, label: "Actifs", icon: "●", cls: "green" },
          { value: s.inactive, label: "Inactifs", icon: "○", cls: "red" },
          { value: s.r5, label: "R5", icon: "★", cls: "gold" },
          { value: s.r4, label: "R4", icon: "◆", cls: "blue" },
          { value: s.members, label: "Membres", icon: "◈", cls: "muted" }
        ];
        grid.innerHTML = cards.map(function (c) {
          return (
            '<div class="stat-card ' + c.cls + '">' +
              '<div class="stat-icon">' + c.icon + "</div>" +
              '<div class="stat-value">' + c.value + "</div>" +
              '<div class="stat-label">' + c.label + "</div>" +
            "</div>"
          );
        }).join("");
      }
    };

    /* ============================= */
    /* GESTION DES JOUEURS           */
    /* ============================= */
    const Players = {
      findByNickname(nickname, excludeId) {
        const n = nickname.trim().toLowerCase();
        return state.players.find(function (p) {
          return p.nickname.toLowerCase() === n && p.id !== excludeId;
        });
      },

      add(data) {
        const player = normalizePlayer({
          id: uid("player"),
          nickname: data.nickname,
          role: data.role,
          status: data.status,
          team: data.team,
          power: data.power,
          note: data.note,
          createdAt: new Date().toISOString(),
          isDemo: false
        });
        state.players.push(player);
        Storage.persist();
        return player;
      },

      update(id, data) {
        const idx = state.players.findIndex(function (p) { return p.id === id; });
        if (idx === -1) return null;
        const existing = state.players[idx];
        state.players[idx] = normalizePlayer({
          ...existing,
          nickname: data.nickname,
          role: data.role,
          status: data.status,
          team: data.team,
          power: data.power,
          note: data.note,
          isDemo: false
        });
        Storage.persist();
        return state.players[idx];
      },

      remove(id) {
        state.players = state.players.filter(function (p) { return p.id !== id; });
        selectedIds.delete(id);
        Storage.persist();
      },

      removeMany(ids) {
        const set = new Set(ids);
        state.players = state.players.filter(function (p) { return !set.has(p.id); });
        ids.forEach(function (id) { selectedIds.delete(id); });
        Storage.persist();
      },

      setStatusMany(ids, status) {
        const set = new Set(ids);
        state.players.forEach(function (p) {
          if (set.has(p.id)) p.status = status;
        });
        Storage.persist();
      },

      removeDemo() {
        const before = state.players.length;
        state.players = state.players.filter(function (p) {
          return !(p.isDemo || CONFIG.demoNicknames.includes(p.nickname));
        });
        const removed = before - state.players.length;
        selectedIds.clear();
        Storage.persist();
        return removed;
      }
    };

    /* ============================= */
    /* RECHERCHE / FILTRES / TRI     */
    /* ============================= */
    const Filters = {
      getQuery() {
        return (document.getElementById("searchInput").value || "").trim().toLowerCase();
      },

      getRole() {
        return document.getElementById("filterRole").value;
      },

      getStatus() {
        return document.getElementById("filterStatus").value;
      },

      getTeam() {
        return document.getElementById("filterTeam").value;
      },

      getSort() {
        return document.getElementById("sortSelect").value;
      },

      reset() {
        document.getElementById("searchInput").value = "";
        document.getElementById("filterRole").value = "";
        document.getElementById("filterStatus").value = "";
        document.getElementById("filterTeam").value = "";
        document.getElementById("sortSelect").value = "az";
      },

      updateTeamOptions() {
        const select = document.getElementById("filterTeam");
        const current = select.value;
        const teams = [];
        state.players.forEach(function (p) {
          if (p.team && teams.indexOf(p.team) === -1) teams.push(p.team);
        });
        teams.sort(function (a, b) {
          return a.localeCompare(b, "fr", { sensitivity: "base" });
        });
        select.innerHTML = '<option value="">Toutes les équipes</option>';
        teams.forEach(function (t) {
          const opt = document.createElement("option");
          opt.value = t;
          opt.textContent = t;
          select.appendChild(opt);
        });
        if (teams.indexOf(current) !== -1) select.value = current;
      },

      getFiltered() {
        const q = this.getQuery();
        const role = this.getRole();
        const status = this.getStatus();
        const team = this.getTeam();
        let list = state.players.slice();

        if (q) {
          list = list.filter(function (p) {
            return (
              p.nickname.toLowerCase().indexOf(q) !== -1 ||
              (p.team && p.team.toLowerCase().indexOf(q) !== -1) ||
              (p.note && p.note.toLowerCase().indexOf(q) !== -1)
            );
          });
        }
        if (role) list = list.filter(function (p) { return p.role === role; });
        if (status) list = list.filter(function (p) { return p.status === status; });
        if (team) list = list.filter(function (p) { return p.team === team; });

        return this.sortList(list, this.getSort());
      },

      sortList(list, sort) {
        const roleOrder = CONFIG.roleOrder;
        const copy = list.slice();
        copy.sort(function (a, b) {
          switch (sort) {
            case "za":
              return b.nickname.localeCompare(a.nickname, "fr", { sensitivity: "base" });
            case "role": {
              const ra = roleOrder[a.role] != null ? roleOrder[a.role] : 99;
              const rb = roleOrder[b.role] != null ? roleOrder[b.role] : 99;
              if (ra !== rb) return ra - rb;
              return a.nickname.localeCompare(b.nickname, "fr", { sensitivity: "base" });
            }
            case "power-asc":
              return parsePower(a.power) - parsePower(b.power);
            case "power-desc":
              return parsePower(b.power) - parsePower(a.power);
            case "newest":
              return new Date(b.createdAt) - new Date(a.createdAt);
            case "oldest":
              return new Date(a.createdAt) - new Date(b.createdAt);
            case "az":
            default:
              return a.nickname.localeCompare(b.nickname, "fr", { sensitivity: "base" });
          }
        });
        return copy;
      }
    };

    function parsePower(value) {
      if (value == null || value === "") return -1;
      const cleaned = String(value).replace(/[^\d.,]/g, "").replace(",", ".");
      const n = parseFloat(cleaned);
      return isNaN(n) ? -1 : n;
    }

    /* ============================= */
    /* SÉLECTION                     */
    /* ============================= */
    const Selection = {
      toggle(id, checked) {
        if (checked) selectedIds.add(id);
        else selectedIds.delete(id);
        this.syncUI();
      },

      selectVisible() {
        Filters.getFiltered().forEach(function (p) { selectedIds.add(p.id); });
        this.syncUI();
        PlayersUI.render();
      },

      deselectAll() {
        selectedIds.clear();
        this.syncUI();
        PlayersUI.render();
      },

      syncUI() {
        const count = selectedIds.size;
        const bar = document.getElementById("bulkBar");
        const label = document.getElementById("bulkCount");
        if (count > 0) {
          bar.classList.add("visible");
          label.textContent = count + " joueur" + (count > 1 ? "s" : "") + " sélectionné" + (count > 1 ? "s" : "");
        } else {
          bar.classList.remove("visible");
        }
        const header = document.getElementById("checkAllHeader");
        const visible = Filters.getFiltered();
        header.checked = visible.length > 0 && visible.every(function (p) { return selectedIds.has(p.id); });
        header.indeterminate = !header.checked && visible.some(function (p) { return selectedIds.has(p.id); });
      },

      getIds() {
        return Array.from(selectedIds);
      }
    };

    /* ============================= */
    /* UI JOUEURS                    */
    /* ============================= */
    const PlayersUI = {
      render() {
        Filters.updateTeamOptions();
        const list = Filters.getFiltered();
        this.renderTable(list);
        this.renderCards(list);
        document.getElementById("resultsMeta").textContent =
          list.length + " / " + state.players.length + " joueur" + (state.players.length !== 1 ? "s" : "");
        Selection.syncUI();
        Stats.render();
      },

      roleBadge(role) {
        const cls = role === "R5" ? "r5" : role === "R4" ? "r4" : "membre";
        return '<span class="badge-role ' + cls + '">' + escapeHtml(role) + "</span>";
      },

      statusBadge(status) {
        const active = status === "active";
        return (
          '<span class="badge-status ' + (active ? "active" : "inactive") + '">' +
          (active ? "Actif" : "Inactif") +
          "</span>"
        );
      },

      renderTable(list) {
        const tbody = document.getElementById("playersTableBody");
        if (!list.length) {
          tbody.innerHTML =
            '<tr><td colspan="7"><div class="empty-state">Aucun joueur trouvé</div></td></tr>';
          return;
        }
        tbody.innerHTML = list.map(function (p) {
          const checked = selectedIds.has(p.id) ? " checked" : "";
          return (
            "<tr data-id=\"" + p.id + "\">" +
              '<td class="col-check"><input type="checkbox" class="checkbox row-check" data-id="' + p.id + '"' + checked + " /></td>" +
              '<td><span class="nick">' + escapeHtml(p.nickname) + "</span></td>" +
              "<td>" + PlayersUI.roleBadge(p.role) + "</td>" +
              "<td>" + PlayersUI.statusBadge(p.status) + "</td>" +
              "<td>" + escapeHtml(p.team || "—") + "</td>" +
              "<td>" + escapeHtml(p.power || "—") + "</td>" +
              '<td class="col-actions">' +
                '<div class="btn-row">' +
                  '<button type="button" class="btn btn-secondary btn-sm btn-edit" data-id="' + p.id + '">Modifier</button>' +
                  '<button type="button" class="btn btn-danger btn-sm btn-delete" data-id="' + p.id + '">Supprimer</button>' +
                "</div>" +
              "</td>" +
            "</tr>"
          );
        }).join("");
      },

      renderCards(list) {
        const wrap = document.getElementById("playerCards");
        if (!list.length) {
          wrap.innerHTML = '<div class="empty-state">Aucun joueur trouvé</div>';
          return;
        }
        wrap.innerHTML = list.map(function (p) {
          const checked = selectedIds.has(p.id) ? " checked" : "";
          return (
            '<article class="player-card" data-id="' + p.id + '">' +
              '<div class="player-card-top">' +
                '<input type="checkbox" class="checkbox row-check" data-id="' + p.id + '"' + checked + " />" +
                '<div class="player-card-info">' +
                  '<div class="nick">' + escapeHtml(p.nickname) + "</div>" +
                  '<div class="player-card-meta">' +
                    PlayersUI.roleBadge(p.role) +
                    PlayersUI.statusBadge(p.status) +
                  "</div>" +
                "</div>" +
              "</div>" +
              '<div class="player-card-details">' +
                (p.team ? "<div>Équipe : <span>" + escapeHtml(p.team) + "</span></div>" : "") +
                (p.power ? "<div>Puissance : <span>" + escapeHtml(p.power) + "</span></div>" : "") +
                (p.note ? "<div>Note : <span>" + escapeHtml(p.note) + "</span></div>" : "") +
              "</div>" +
              '<div class="player-card-actions">' +
                '<button type="button" class="btn btn-secondary btn-sm btn-edit" data-id="' + p.id + '">Modifier</button>' +
                '<button type="button" class="btn btn-danger btn-sm btn-delete" data-id="' + p.id + '">Supprimer</button>' +
              "</div>" +
            "</article>"
          );
        }).join("");
      }
    };

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    /* ============================= */
    /* MODALES                       */
    /* ============================= */
    const Modal = {
      openPlayer(player) {
        editingId = player ? player.id : null;
        document.getElementById("playerModalTitle").textContent =
          player ? "Modifier un joueur" : "Ajouter un joueur";
        document.getElementById("playerId").value = player ? player.id : "";
        document.getElementById("playerNickname").value = player ? player.nickname : "";
        document.getElementById("playerRole").value = player ? player.role : "Membre";
        document.getElementById("playerStatus").value = player ? player.status : "active";
        document.getElementById("playerTeam").value = player ? player.team : "";
        document.getElementById("playerPower").value = player ? player.power : "";
        document.getElementById("playerNote").value = player ? player.note : "";
        document.getElementById("nicknameError").classList.remove("visible");
        document.getElementById("playerModal").classList.add("open");
        setTimeout(function () {
          document.getElementById("playerNickname").focus();
        }, 50);
      },

      closePlayer() {
        document.getElementById("playerModal").classList.remove("open");
        editingId = null;
        document.getElementById("playerForm").reset();
      },

      confirm(options) {
        document.getElementById("confirmTitle").textContent = options.title || "Confirmation";
        document.getElementById("confirmMessage").textContent = options.message || "";
        document.getElementById("confirmOk").textContent = options.okLabel || "Confirmer";
        document.getElementById("confirmOk").className =
          "btn " + (options.danger !== false ? "btn-danger" : "btn-primary");
        confirmCallback = options.onConfirm || null;
        document.getElementById("confirmModal").classList.add("open");
      },

      closeConfirm() {
        document.getElementById("confirmModal").classList.remove("open");
        confirmCallback = null;
      }
    };

    /* ============================= */
    /* NAVIGATION                    */
    /* ============================= */
    const Nav = {
      go(page) {
        document.querySelectorAll(".page").forEach(function (el) {
          el.classList.toggle("active", el.dataset.page === page);
        });
        document.querySelectorAll(".nav-btn").forEach(function (btn) {
          btn.classList.toggle("active", btn.dataset.page === page);
        });
        this.closeSidebar();
        window.scrollTo(0, 0);
      },

      openSidebar() {
        document.getElementById("sidebar").classList.add("open");
        document.getElementById("sidebarBackdrop").classList.add("visible");
      },

      closeSidebar() {
        document.getElementById("sidebar").classList.remove("open");
        document.getElementById("sidebarBackdrop").classList.remove("visible");
      },

      toggleSidebar() {
        if (document.getElementById("sidebar").classList.contains("open")) this.closeSidebar();
        else this.openSidebar();
      }
    };

    /* ============================= */
    /* IMPORT / EXPORT               */
    /* ============================= */
    const Backup = {
      export() {
        const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "5LE-manager-backup.json";
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        Notifications.show("Données exportées", "success");
      },

      importFile(file) {
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (e) {
          try {
            const parsed = JSON.parse(e.target.result);
            if (!parsed || typeof parsed !== "object" || !Array.isArray(parsed.players)) {
              Notifications.show("Sauvegarde invalide.", "error");
              return;
            }
            Modal.confirm({
              title: "Importer une sauvegarde",
              message: "Cette action remplacera toutes les données actuelles. Continuer ?",
              okLabel: "Importer",
              danger: true,
              onConfirm: function () {
                state = Storage.normalize(parsed);
                selectedIds.clear();
                Storage.persist();
                PlayersUI.render();
                Notifications.show("Sauvegarde importée", "success");
              }
            });
          } catch (err) {
            Notifications.show("Sauvegarde invalide.", "error");
          }
        };
        reader.onerror = function () {
          Notifications.show("Sauvegarde invalide.", "error");
        };
        reader.readAsText(file);
      }
    };

    /* ============================= */
    /* ÉVÉNEMENTS                    */
    /* ============================= */
    function bindEvents() {
      document.getElementById("mainNav").addEventListener("click", function (e) {
        const btn = e.target.closest(".nav-btn");
        if (!btn) return;
        Nav.go(btn.dataset.page);
      });

      document.getElementById("menuToggle").addEventListener("click", function () {
        Nav.toggleSidebar();
      });
      document.getElementById("sidebarBackdrop").addEventListener("click", function () {
        Nav.closeSidebar();
      });

      document.getElementById("btnAddPlayer").addEventListener("click", function () {
        Modal.openPlayer(null);
      });
      document.getElementById("playerModalClose").addEventListener("click", Modal.closePlayer);
      document.getElementById("playerFormCancel").addEventListener("click", Modal.closePlayer);
      document.getElementById("playerModal").addEventListener("click", function (e) {
        if (e.target === this) Modal.closePlayer();
      });

      document.getElementById("playerForm").addEventListener("submit", function (e) {
        e.preventDefault();
        const nickname = document.getElementById("playerNickname").value.trim();
        const errorEl = document.getElementById("nicknameError");
        errorEl.classList.remove("visible");

        if (!nickname) {
          document.getElementById("playerNickname").focus();
          return;
        }

        if (Players.findByNickname(nickname, editingId)) {
          errorEl.classList.add("visible");
          document.getElementById("playerNickname").focus();
          return;
        }

        const payload = {
          nickname: nickname,
          role: document.getElementById("playerRole").value,
          status: document.getElementById("playerStatus").value,
          team: document.getElementById("playerTeam").value.trim(),
          power: document.getElementById("playerPower").value.trim(),
          note: document.getElementById("playerNote").value.trim()
        };

        if (editingId) {
          Players.update(editingId, payload);
          Notifications.show("Joueur modifié", "success");
        } else {
          Players.add(payload);
          Notifications.show("Joueur ajouté", "success");
        }

        Modal.closePlayer();
        PlayersUI.render();
      });

      document.getElementById("searchInput").addEventListener("input", function () {
        PlayersUI.render();
      });
      document.getElementById("filterRole").addEventListener("change", function () { PlayersUI.render(); });
      document.getElementById("filterStatus").addEventListener("change", function () { PlayersUI.render(); });
      document.getElementById("filterTeam").addEventListener("change", function () { PlayersUI.render(); });
      document.getElementById("sortSelect").addEventListener("change", function () { PlayersUI.render(); });
      document.getElementById("btnResetFilters").addEventListener("click", function () {
        Filters.reset();
        PlayersUI.render();
      });

      document.getElementById("btnSelectAll").addEventListener("click", function () {
        Selection.selectVisible();
      });
      document.getElementById("btnDeselectAll").addEventListener("click", function () {
        Selection.deselectAll();
      });
      document.getElementById("checkAllHeader").addEventListener("change", function (e) {
        if (e.target.checked) Selection.selectVisible();
        else Selection.deselectAll();
      });

      document.getElementById("page-players").addEventListener("click", function (e) {
        const check = e.target.closest(".row-check");
        if (check) {
          Selection.toggle(check.dataset.id, check.checked);
          return;
        }
        const editBtn = e.target.closest(".btn-edit");
        if (editBtn) {
          const player = state.players.find(function (p) { return p.id === editBtn.dataset.id; });
          if (player) Modal.openPlayer(player);
          return;
        }
        const delBtn = e.target.closest(".btn-delete");
        if (delBtn) {
          const id = delBtn.dataset.id;
          const player = state.players.find(function (p) { return p.id === id; });
          Modal.confirm({
            title: "Supprimer un joueur",
            message: "Voulez-vous vraiment supprimer ce joueur ?" +
              (player ? " (" + player.nickname + ")" : ""),
            okLabel: "Supprimer",
            onConfirm: function () {
              Players.remove(id);
              PlayersUI.render();
              Notifications.show("Joueur supprimé", "success");
            }
          });
        }
      });

      document.getElementById("btnBulkActive").addEventListener("click", function () {
        const ids = Selection.getIds();
        if (!ids.length) return;
        Players.setStatusMany(ids, "active");
        PlayersUI.render();
        Notifications.show("Statut mis à jour (Actif)", "success");
      });
      document.getElementById("btnBulkInactive").addEventListener("click", function () {
        const ids = Selection.getIds();
        if (!ids.length) return;
        Players.setStatusMany(ids, "inactive");
        PlayersUI.render();
        Notifications.show("Statut mis à jour (Inactif)", "success");
      });
      document.getElementById("btnBulkDelete").addEventListener("click", function () {
        const ids = Selection.getIds();
        if (!ids.length) return;
        Modal.confirm({
          title: "Suppression multiple",
          message: "Voulez-vous vraiment supprimer " + ids.length + " joueur" + (ids.length > 1 ? "s" : "") + " ?",
          okLabel: "Supprimer",
          onConfirm: function () {
            Players.removeMany(ids);
            PlayersUI.render();
            Notifications.show("Joueurs supprimés", "success");
          }
        });
      });

      document.getElementById("confirmClose").addEventListener("click", Modal.closeConfirm);
      document.getElementById("confirmCancel").addEventListener("click", Modal.closeConfirm);
      document.getElementById("confirmModal").addEventListener("click", function (e) {
        if (e.target === this) Modal.closeConfirm();
      });
      document.getElementById("confirmOk").addEventListener("click", function () {
        const cb = confirmCallback;
        Modal.closeConfirm();
        if (typeof cb === "function") cb();
      });

      document.getElementById("btnExport").addEventListener("click", function () {
        Backup.export();
      });
      document.getElementById("btnImport").addEventListener("click", function () {
        document.getElementById("importFile").click();
      });
      document.getElementById("importFile").addEventListener("change", function (e) {
        const file = e.target.files && e.target.files[0];
        Backup.importFile(file);
        e.target.value = "";
      });

      document.getElementById("btnRemoveDemo").addEventListener("click", function () {
        const removed = Players.removeDemo();
        PlayersUI.render();
        if (removed > 0) Notifications.show(removed + " joueur(s) de démonstration supprimé(s)", "success");
        else Notifications.show("Aucun joueur de démonstration trouvé", "info");
      });

      document.getElementById("btnWipeAll").addEventListener("click", function () {
        Modal.confirm({
          title: "Zone dangereuse",
          message: "Première confirmation : voulez-vous vraiment supprimer TOUTES les données ?",
          okLabel: "Continuer",
          onConfirm: function () {
            setTimeout(function () {
              Modal.confirm({
                title: "Dernière confirmation",
                message: "Cette action est irréversible. Confirmer la suppression totale ?",
                okLabel: "Supprimer tout",
                onConfirm: function () {
                  state = createEmptyData();
                  selectedIds.clear();
                  Storage.persist();
                  PlayersUI.render();
                  Notifications.show("Toutes les données ont été supprimées", "success");
                }
              });
            }, 150);
          }
        });
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
          if (document.getElementById("confirmModal").classList.contains("open")) Modal.closeConfirm();
          else if (document.getElementById("playerModal").classList.contains("open")) Modal.closePlayer();
          else Nav.closeSidebar();
        }
      });
    }

    /* ============================= */
    /* INIT                          */
    /* ============================= */
    function init() {
      const loaded = Storage.load();
      if (loaded) {
        state = loaded;
      } else {
        state = createEmptyData();
        state.players = createDemoPlayers();
        Storage.persist();
      }
      bindEvents();
      PlayersUI.render();
    }

    init();
  })();
  </script>
</body>
</html>
