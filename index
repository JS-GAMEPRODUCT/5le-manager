<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0a0a0c" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <title>5LE MANAGER</title>

  <!-- ============================= -->
  <!-- CONFIGURATION (meta)        -->
  <!-- ============================= -->

  <!-- ============================= -->
  <!-- CSS                         -->
  <!-- ============================= -->
  <style>
    :root {
      --bg: #07080a;
      --bg-elevated: #101218;
      --bg-card: #141820;
      --bg-hover: #1a1f2a;
      --border: #2a3140;
      --border-gold: #c9a227;
      --gold: #d4af37;
      --gold-soft: #e8c547;
      --gold-dim: rgba(212, 175, 55, 0.15);
      --blue: #3a7bd5;
      --blue-bright: #4f8ff0;
      --blue-dim: rgba(58, 123, 213, 0.18);
      --red: #c0392b;
      --red-bright: #e74c3c;
      --red-dim: rgba(192, 57, 43, 0.18);
      --green: #2ecc71;
      --text: #e8eaef;
      --text-muted: #8b93a7;
      --text-dim: #5c6578;
      --radius: 12px;
      --radius-sm: 8px;
      --shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
      --sidebar-w: 240px;
      --header-h: 64px;
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --font: "Segoe UI", system-ui, -apple-system, sans-serif;
      --font-display: "Segoe UI", system-ui, -apple-system, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      min-height: 100dvh;
      line-height: 1.45;
      overflow-x: hidden;
      background-image:
        radial-gradient(ellipse 80% 50% at 20% -10%, rgba(58, 123, 213, 0.12), transparent),
        radial-gradient(ellipse 60% 40% at 90% 10%, rgba(212, 175, 55, 0.08), transparent),
        linear-gradient(180deg, #0a0b0e 0%, #07080a 100%);
    }

    button, input, select, textarea {
      font: inherit;
      color: inherit;
    }

    button { cursor: pointer; border: none; background: none; }
    img { max-width: 100%; display: block; }
    a { color: var(--gold); }

    /* ---------- Layout ---------- */
    .app {
      display: flex;
      min-height: 100dvh;
    }

    .sidebar {
      width: var(--sidebar-w);
      flex-shrink: 0;
      background: linear-gradient(180deg, #0e1016 0%, #0a0c10 100%);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 100;
      transition: transform 0.25s ease;
    }

    .brand {
      padding: 1.25rem 1.25rem 1rem;
      border-bottom: 1px solid var(--border);
    }

    .brand-title {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      color: var(--gold);
      text-shadow: 0 0 24px rgba(212, 175, 55, 0.25);
      line-height: 1.2;
    }

    .brand-sub {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
      letter-spacing: 0.04em;
    }

    .nav {
      padding: 0.75rem;
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .nav-btn {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.95rem;
      text-align: left;
      transition: background 0.15s, color 0.15s;
      min-height: 48px;
    }

    .nav-btn:hover { background: var(--bg-hover); color: var(--text); }
    .nav-btn.active {
      background: var(--gold-dim);
      color: var(--gold);
      border: 1px solid rgba(212, 175, 55, 0.35);
    }

    .nav-icon {
      width: 1.25rem;
      text-align: center;
      opacity: 0.9;
      flex-shrink: 0;
    }

    .sidebar-footer {
      padding: 1rem 1.25rem;
      border-top: 1px solid var(--border);
      font-size: 0.7rem;
      color: var(--text-dim);
      letter-spacing: 0.05em;
    }

    .main {
      flex: 1;
      margin-left: var(--sidebar-w);
      min-width: 0;
      display: flex;
      flex-direction: column;
      min-height: 100dvh;
    }

    .topbar {
      display: none;
      position: sticky;
      top: 0;
      z-index: 90;
      height: var(--header-h);
      background: rgba(10, 11, 14, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      align-items: center;
      padding: 0 1rem;
      gap: 0.75rem;
    }

    .menu-toggle {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--gold);
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .topbar-title {
      font-weight: 800;
      letter-spacing: 0.05em;
      color: var(--gold);
      font-size: 1.05rem;
    }

    .content {
      padding: 1.5rem 1.75rem 2.5rem;
      flex: 1;
      width: 100%;
      max-width: 1200px;
    }

    .page { display: none; animation: fadeIn 0.2s ease; }
    .page.active { display: block; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: none; }
    }

    .page-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .page-header h1 {
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: 0.02em;
    }

    .page-header p {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-top: 0.2rem;
    }

    /* ---------- Cards / Stats ---------- */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 1rem;
    }

    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.15rem 1rem;
      position: relative;
      overflow: hidden;
      transition: border-color 0.15s, transform 0.15s;
    }

    .stat-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--accent, var(--gold));
    }

    .stat-card:hover {
      border-color: rgba(212, 175, 55, 0.4);
      transform: translateY(-1px);
    }

    .stat-card.gold { --accent: var(--gold); }
    .stat-card.blue { --accent: var(--blue); }
    .stat-card.green { --accent: var(--green); }
    .stat-card.red { --accent: var(--red); }
    .stat-card.muted { --accent: var(--text-dim); }

    .stat-icon {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
      opacity: 0.85;
    }

    .stat-value {
      font-size: 1.85rem;
      font-weight: 800;
      color: var(--text);
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .stat-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 0.4rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .panel {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1.35rem;
      margin-top: 1.25rem;
    }

    .panel h2 {
      font-size: 1.05rem;
      margin-bottom: 0.5rem;
      color: var(--gold-soft);
    }

    .panel p { color: var(--text-muted); font-size: 0.92rem; }

    .coming-soon {
      text-align: center;
      padding: 3rem 1.5rem;
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      background: var(--bg-elevated);
    }

    .coming-soon .badge {
      display: inline-block;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      background: var(--blue-dim);
      color: var(--blue-bright);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    .coming-soon h2 { font-size: 1.25rem; margin-bottom: 0.5rem; }
    .coming-soon p { color: var(--text-muted); max-width: 360px; margin: 0 auto; }

    /* ---------- Buttons ---------- */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.75rem 1.15rem;
      min-height: 48px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      font-size: 0.95rem;
      border: 1px solid transparent;
      transition: background 0.15s, border-color 0.15s, opacity 0.15s, transform 0.1s;
      white-space: nowrap;
      user-select: none;
    }

    .btn:active { transform: scale(0.98); }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }

    .btn-primary {
      background: linear-gradient(180deg, #e0b83d 0%, #c9a227 100%);
      color: #1a1408;
      box-shadow: 0 4px 16px rgba(212, 175, 55, 0.25);
    }
    .btn-primary:hover { filter: brightness(1.06); }

    .btn-secondary {
      background: var(--bg-elevated);
      border-color: var(--border);
      color: var(--text);
    }
    .btn-secondary:hover { background: var(--bg-hover); border-color: var(--text-dim); }

    .btn-danger {
      background: var(--red-dim);
      border-color: rgba(192, 57, 43, 0.5);
      color: #ff8a7a;
    }
    .btn-danger:hover { background: rgba(192, 57, 43, 0.3); }

    .btn-ghost {
      background: transparent;
      border-color: var(--border);
      color: var(--text-muted);
    }
    .btn-ghost:hover { color: var(--text); background: var(--bg-hover); }

    .btn-sm {
      min-height: 40px;
      padding: 0.45rem 0.85rem;
      font-size: 0.85rem;
    }

    .btn-block { width: 100%; }

    .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    /* ---------- Forms ---------- */
    .form-group { margin-bottom: 1rem; }
    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .form-control {
      width: 100%;
      padding: 0.8rem 0.95rem;
      min-height: 48px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      color: var(--text);
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .form-control:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px var(--gold-dim);
    }

    textarea.form-control {
      min-height: 88px;
      resize: vertical;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
    }

    .form-error {
      color: var(--red-bright);
      font-size: 0.85rem;
      margin-top: 0.35rem;
      display: none;
    }
    .form-error.visible { display: block; }

    /* ---------- Toolbar (players) ---------- */
    .toolbar {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    .toolbar-top {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      justify-content: space-between;
    }

    .search-wrap {
      flex: 1;
      min-width: 180px;
      max-width: 420px;
      position: relative;
    }

    .search-wrap .form-control { padding-left: 2.5rem; }

    .search-icon {
      position: absolute;
      left: 0.9rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-dim);
      pointer-events: none;
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      align-items: center;
    }

    .filters select.form-control {
      width: auto;
      min-width: 140px;
      min-height: 44px;
      padding: 0.55rem 0.75rem;
    }

    .results-meta {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* ---------- Selection bar ---------- */
    .bulk-bar {
      display: none;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.65rem;
      padding: 0.85rem 1rem;
      background: var(--blue-dim);
      border: 1px solid rgba(58, 123, 213, 0.4);
      border-radius: var(--radius);
      margin-bottom: 1rem;
    }

    .bulk-bar.visible { display: flex; }

    .bulk-count {
      font-weight: 700;
      color: var(--blue-bright);
      margin-right: 0.25rem;
    }

    /* ---------- Table (desktop) ---------- */
    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-elevated);
      -webkit-overflow-scrolling: touch;
    }

    table.players-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 720px;
    }

    .players-table th,
    .players-table td {
      padding: 0.85rem 0.9rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    .players-table th {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      background: rgba(0, 0, 0, 0.25);
      font-weight: 700;
      white-space: nowrap;
      position: sticky;
      top: 0;
    }

    .players-table tr:last-child td { border-bottom: none; }
    .players-table tbody tr:hover { background: var(--bg-hover); }

    .players-table .col-check { width: 44px; }
    .players-table .col-actions { white-space: nowrap; width: 1%; }

    .checkbox {
      width: 20px;
      height: 20px;
      accent-color: var(--gold);
      cursor: pointer;
    }

    .badge-role, .badge-status {
      display: inline-block;
      padding: 0.25rem 0.55rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.04em;
    }

    .badge-role.r5 { background: rgba(212, 175, 55, 0.2); color: var(--gold); }
    .badge-role.r4 { background: var(--blue-dim); color: var(--blue-bright); }
    .badge-role.membre { background: rgba(139, 147, 167, 0.2); color: var(--text-muted); }

    .badge-status.active { background: rgba(46, 204, 113, 0.15); color: var(--green); }
    .badge-status.inactive { background: var(--red-dim); color: #ff8a7a; }

    .nick {
      font-weight: 700;
      font-size: 0.98rem;
    }

    .empty-state {
      text-align: center;
      padding: 2.5rem 1rem;
      color: var(--text-muted);
    }

    /* ---------- Cards (mobile players) ---------- */
    .player-cards { display: none; }

    .player-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem;
      margin-bottom: 0.75rem;
    }

    .player-card-top {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .player-card-info { flex: 1; min-width: 0; }

    .player-card-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.45rem;
    }

    .player-card-details {
      display: grid;
      gap: 0.35rem;
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-bottom: 0.85rem;
      padding-left: 2rem;
    }

    .player-card-details span { color: var(--text); font-weight: 600; }

    .player-card-actions {
      display: flex;
      gap: 0.5rem;
      padding-left: 2rem;
    }

    .player-card-actions .btn { flex: 1; }

    /* ---------- Modal ---------- */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.72);
      z-index: 200;
      display: none;
      align-items: flex-end;
      justify-content: center;
      padding: 0;
      backdrop-filter: blur(4px);
    }

    .modal-overlay.open { display: flex; }

    .modal {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius) var(--radius) 0 0;
      width: 100%;
      max-width: 520px;
      max-height: 92dvh;
      overflow-y: auto;
      box-shadow: var(--shadow);
      padding: 1.25rem 1.25rem calc(1.25rem + var(--safe-bottom));
      animation: slideUp 0.22s ease;
    }

    @keyframes slideUp {
      from { transform: translateY(24px); opacity: 0; }
      to { transform: none; opacity: 1; }
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.15rem;
      gap: 1rem;
    }

    .modal-header h2 {
      font-size: 1.2rem;
      color: var(--gold);
    }

    .modal-close {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-actions {
      display: flex;
      gap: 0.65rem;
      margin-top: 1.25rem;
    }

    .modal-actions .btn { flex: 1; }

    .modal-body-text {
      color: var(--text-muted);
      margin-bottom: 0.5rem;
      font-size: 0.95rem;
    }

    /* ---------- Settings ---------- */
    .settings-section {
      margin-bottom: 1.5rem;
    }

    .settings-section h2 {
      font-size: 1.05rem;
      margin-bottom: 0.65rem;
      color: var(--gold-soft);
    }

    .settings-section p {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 0.85rem;
    }

    .danger-zone {
      border: 1px solid rgba(192, 57, 43, 0.45);
      background: var(--red-dim);
      border-radius: var(--radius);
      padding: 1.15rem;
    }

    .danger-zone h2 { color: #ff8a7a; }

    .hidden-file { display: none; }

    /* ---------- Toasts ---------- */
    .toast-container {
      position: fixed;
      bottom: calc(1rem + var(--safe-bottom));
      right: 1rem;
      left: 1rem;
      z-index: 300;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      pointer-events: none;
      align-items: flex-end;
      max-width: 400px;
      margin-left: auto;
    }

    .toast {
      pointer-events: auto;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-left: 4px solid var(--gold);
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow);
      font-weight: 600;
      font-size: 0.9rem;
      animation: toastIn 0.25s ease;
      width: 100%;
    }

    .toast.success { border-left-color: var(--green); }
    .toast.error { border-left-color: var(--red-bright); }
    .toast.info { border-left-color: var(--blue); }

    @keyframes toastIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: none; }
    }

    /* ---------- Overlay mobile menu ---------- */
    .sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      z-index: 95;
    }

    .sidebar-backdrop.visible { display: block; }

    /* ---------- Desktop modal ---------- */
    @media (min-width: 641px) {
      .modal-overlay {
        align-items: center;
        padding: 1.5rem;
      }
      .modal {
        border-radius: var(--radius);
        padding: 1.5rem;
      }
    }

    /* ---------- Mobile ---------- */
    @media (max-width: 900px) {
      .sidebar {
        transform: translateX(-100%);
      }
      .sidebar.open { transform: translateX(0); }

      .main { margin-left: 0; }
      .topbar { display: flex; }

      .content {
        padding: 1rem 1rem calc(1.5rem + var(--safe-bottom));
      }

      .page-header h1 { font-size: 1.35rem; }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
      }

      .stat-value { font-size: 1.55rem; }

      .form-row { grid-template-columns: 1fr; }

      .table-wrap { display: none; }
      .player-cards { display: block; }

      .filters select.form-control {
        flex: 1 1 calc(50% - 0.3rem);
        min-width: 0;
      }

      .toolbar-top .btn-primary {
        width: 100%;
      }

      .search-wrap { max-width: none; width: 100%; }

      .bulk-bar .btn { flex: 1 1 auto; min-width: calc(50% - 0.35rem); }
    }

    @media (max-width: 380px) {
      .stats-grid { grid-template-columns: 1fr 1fr; }
      .filters select.form-control { flex: 1 1 100%; }
    }

    @media (min-width: 901px) {
      .player-cards { display: none !important; }
      .table-wrap { display: block; }
    }
  </style>
</head>
<body>

  <!-- ============================= -->
  <!-- HTML                        -->
  <!-- ============================= -->

  <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

  <div class="app">
    <!-- Side navigation -->
    <aside class="sidebar" id="sidebar" aria-label="Navigation">
      <div class="brand">
        <div class="brand-title">5LE MANAGER</div>
        <div class="brand-sub">Gestion de l'alliance</div>
      </div>
